{
  "expo": {
    "name": "Adventist Life",
    "slug": "streams",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "streams",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "assets/*.db"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ankom.streams",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Allow microphone access to broadcast live audio and record video with sound.",
        "NSCameraUsageDescription": "Allow camera access to broadcast live video and take photos and videos for your posts.",
        "NSPhotoLibraryUsageDescription": "Allow access to your photos so you can pick images and videos for your posts.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving photos and videos you download or capture to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#4797C6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ankom.streams",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1DA1F2"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take photos and videos for your posts.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record video with sound.",
          "recordAudioAndroid": true
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce25330b-30db-4e8c-b99b-c03d70772178"
      }
    },
    "owner": "ankomark"
  }
}
