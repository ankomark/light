# The live box's settings. Copy to `.env` (never committed) and fill in:
#
#   cp livekit.env.example .env && nano .env
#
# setup.sh reads this file and writes livekit.yaml and caddy.yaml from the
# templates next to it.

# What the app connects to (signalling, wss://). An A record pointing at this box.
LIVE_DOMAIN=live.example.com

# TURN over TLS on port 443 - how phones on carrier networks that block UDP
# still get through. A second A record, same IP as LIVE_DOMAIN.
TURN_DOMAIN=turn.example.com

# The key pair Django signs tokens with and LiveKit signs webhooks with.
# Make a fresh pair on the box (don't reuse an old one):
#   docker run --rm livekit/livekit-server generate-keys
# The secret must be at least 32 characters.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where LiveKit tells Django about rooms (host left, room finished, viewer
# counts). Must be the API's public HTTPS address.
WEBHOOK_URL=https://api.example.com/api/live/webhook/

# Pin the server version once a release has been tried on real phones
# (e.g. v1.9.1); `latest` is fine for the very first install only.
LIVEKIT_VERSION=latest

# Email for Let's Encrypt (certificate expiry warnings).
ACME_EMAIL=admin@example.com
