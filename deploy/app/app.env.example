# The app box's settings. Copy to `.env` in this folder (never committed) and
# fill in every value marked REQUIRED:
#
#   cp app.env.example .env && chmod 600 .env && nano .env
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ── The server ───────────────────────────────────────────────────────────────
# REQUIRED. The API's public name (an A record pointing at this box, DNS only
# - not proxied). The app is built with https://<this> as EXPO_PUBLIC_API_BASE.
API_DOMAIN=api.example.com
# REQUIRED. Let's Encrypt expiry warnings.
ACME_EMAIL=admin@example.com

DJANGO_ENV=production
DJANGO_DEBUG=False
# REQUIRED. Changing it later signs everyone out.
DJANGO_SECRET_KEY=
# REQUIRED. Encrypts admins' authenticator secrets; changing it later resets
# every admin's two-step sign-in.
ADMIN_SECRET_KEY=
# REQUIRED. Same as API_DOMAIN.
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# Browser origins allowed to call the API (a web build of the app); empty = none.
DJANGO_CORS_ORIGINS=
# Caddy is the one proxy in front: the client's address is the last hop it adds.
TRUSTED_PROXY_COUNT=1
# Django's own /admin pages stay off in production (the app has its own admin).
DJANGO_ADMIN_ENABLED=False
ADMIN_2FA_REQUIRED=True

# Gunicorn (advent-backend/gunicorn.conf.py): 4 processes x 4 threads on a CX33.
WEB_CONCURRENCY=4
WEB_THREADS=4

# ── Database (the db container) ──────────────────────────────────────────────
POSTGRES_DB=adventlife
POSTGRES_USER=adventlife
# REQUIRED. Letters and digits only (it goes into DATABASE_URL below).
POSTGRES_PASSWORD=
# REQUIRED. The same password again, in the URL.
DATABASE_URL=postgres://adventlife:CHANGE-ME@db:5432/adventlife
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600

REDIS_URL=redis://redis:6379/0

# ── Media storage: Cloudflare R2 ─────────────────────────────────────────────
# REQUIRED. Uploads are refused while R2_PUBLIC_BASE is empty (a link to
# anywhere else is never accepted).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The public address files are served from (a custom domain on the bucket,
# e.g. https://media.example.com), no trailing slash.
R2_PUBLIC_BASE=
# REQUIRED. Database backups: a SEPARATE bucket with no public access (a dump
# holds every account). The keys above must be allowed to write to it.
BACKUP_R2_BUCKET=

# ── Email (verification codes, password resets, security notices) ───────────
# REQUIRED for real sending; without it codes only reach the log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Adventist Life <noreply@example.com>
REQUIRE_EMAIL_VERIFICATION=True

# ── Error reports ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Live broadcasting: the live server comes later (deploy/livekit) ──────────
# Empty: Go Live answers "Live is unavailable right now" instead of making a
# broadcast nobody can join. Fill in when the live box is up, then restart:
#   docker compose up -d web ws worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Optional features ────────────────────────────────────────────────────────
# AI answers in books and the quiz "Why?" (buttons hidden while empty).
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=40
# Marketplace card payments (M-Pesa runs through the ticketing server).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Events & Tickets: the separate ticketing server, and the shared staff key
# (the same value as STAFF_SERVICE_KEY there).
TICKETING_API_URL=
TICKETING_SERVICE_KEY=

# ── The app's day ────────────────────────────────────────────────────────────
# Quiz days, streaks and the morning pushes turn over at midnight here.
QUIZ_TZ=Africa/Nairobi
QUIZ_REMINDER_TZ=Africa/Nairobi

# Store links (shared pages, "Rate the app").
APP_PLAY_STORE_URL=
APP_STORE_URL=
# Picture used on a shared link with no image of its own.
SHARE_FALLBACK_IMAGE=
